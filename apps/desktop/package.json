{
  "name": "@durabull/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Durabull native desktop shell",
  "author": "Durabull",
  "main": "dist/main.js",
  "scripts": {
    "build": "bun run build:main && bun run stage",
    "build:main": "bun build src/main.ts --target=node --format=cjs --outfile=dist/main.js --external electron",
    "stage": "bun scripts/stage.ts",
    "start": "bun run build && electron .",
    "dist": "bun run build && electron-builder --publish never",
    "dist:publish": "bun run build && electron-builder --publish always",
    "dist:dir": "bun run build && electron-builder --dir --publish never",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src ./scripts",
    "lint:fix": "biome lint --write ./src ./scripts",
    "format": "biome format --write ./src ./scripts",
    "format:check": "biome format ./src ./scripts"
  },
  "devDependencies": {
    "@durabull/api": "workspace:*",
    "@durabull/web": "workspace:*",
    "@types/node": "^22.10.5",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.durabull.desktop",
    "productName": "Durabull",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/app-bundle",
        "to": "app-bundle",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
