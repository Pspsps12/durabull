# URL of the main web application (for auth links)
NEXT_PUBLIC_WEB_APP_URL=https://app.durabull.io

# Site URL for this docs/marketing site (optional, defaults to https://durabull.io)
NEXT_PUBLIC_SITE_URL=https://durabull.io

# PostHog (baked at build time for static export)
# Use the SAME project key as the web app so users are stitched across docs -> app.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key

# Docs always sends PostHog traffic through the web app proxy at:
# ${NEXT_PUBLIC_WEB_APP_URL}/ingest

# Google Analytics (production builds only; optional override)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
